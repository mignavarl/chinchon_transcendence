# Copiar este fichero a .env y poner valores reales.
# El .env NO se sube al repositorio (esta en .gitignore).

POSTGRES_USER=chinchon
POSTGRES_PASSWORD=pon_aqui_una_password
POSTGRES_DB=chinchon

# Conexion del gateway a Postgres. El host "postgres" es el nombre del
# servicio en docker compose, que se resuelve dentro de la red interna.
# El usuario/password/db de esta URL deben coincidir con los de arriba.
DATABASE_URL=postgres://chinchon:pon_aqui_una_password@postgres:5432/chinchon

GATEWAY_PORT=3000
