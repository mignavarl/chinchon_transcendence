# ==========================================================
# PostgreSQL Database Configuration
# - POSTGRES_DB: name of the database to be created
# - POSTGRES_USER: username for the database
# - POSTGRES_PASSWORD: password for the database user
# ==========================================================
POSTGRES_DB=transcendence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ==========================================================
# Spring Boot DataSource Configuration
# - SPRING_DATASOURCE_URL: JDBC URL for the database connection
# - SPRING_DATASOURCE_USERNAME: database username
# - SPRING_DATASOURCE_PASSWORD: database password
# ==========================================================
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/transcendence
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
