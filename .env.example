# Copiar este fichero a .env y poner valores reales.
# El .env NO se sube al repositorio (esta en .gitignore).

# ==========================================================
# PostgreSQL Database Configuration
# Hay UNA sola base de datos, compartida por el backend de Spring
# y por el db_gateway. Si cambias algo aqui, actualiza tambien
# SPRING_DATASOURCE_* y DATABASE_URL mas abajo.
# - POSTGRES_DB: name of the database to be created
# - POSTGRES_USER: username for the database
# - POSTGRES_PASSWORD: password for the database user
# ==========================================================
POSTGRES_DB=transcendence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pon_aqui_una_password

# ==========================================================
# Spring Boot DataSource Configuration
# - SPRING_DATASOURCE_URL: JDBC URL for the database connection
# - SPRING_DATASOURCE_USERNAME: database username
# - SPRING_DATASOURCE_PASSWORD: database password
# ==========================================================
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/transcendence
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=pon_aqui_una_password

# ==========================================================
# Conexion del gateway a Postgres. El host "postgres" es el nombre del
# servicio en docker compose, que se resuelve dentro de la red interna.
# El usuario/password/db de esta URL deben coincidir con los de arriba.
# ==========================================================
DATABASE_URL=postgres://postgres:pon_aqui_una_password@postgres:5432/transcendence

GATEWAY_PORT=3000
